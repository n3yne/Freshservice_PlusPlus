{
  "name": "msp-pp",
  "version": "0.7.6",
  "description": "MSP++: a wrapper for MSP and ticketing sites with a plugin side panel and ticket note backup",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "lint": "eslint .",
    "test": "jest",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis",
    "build-mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/test/electron-stub.js"
    }
  },
  "build": {
    "appId": "com.n3yne.freshservicepp",
    "productName": "MSP++",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "address-bar.js",
      "page-zoom.js",
      "tab-shortcuts.js",
      "command-palette.js",
      "unread-tabs.js",
      "site-colors.js",
      "safe-html.js",
      "settings_renderer.js",
      "launch.js",
      "utils.js",
      "updater.js",
      "webauthn.js",
      "permissions.js",
      "settings-transfer.js",
      "plugin-manager.js",
      "index.html",
      "child-window.html",
      "child-window.js",
      "settings.html",
      "styles.css",
      "icon.png",
      "plugins/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MSP-PlusPlus-Setup-${version}.${ext}",
      "shortcutName": "MSP++",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png",
      "category": "public.app-category.business"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "n3yne",
        "repo": "MSP_PlusPlus",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
