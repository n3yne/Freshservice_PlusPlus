{
  "name": "msp-pp",
  "version": "0.6.0",
  "description": "MSP++: a wrapper for MSP and ticketing sites with a plugin side panel and ticket note backup",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "lint": "eslint .",
    "test": "jest",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable",
    "build-mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/test/electron-stub.js"
    }
  },
  "build": {
    "appId": "com.n3yne.freshservicepp",
    "productName": "MSP++",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "settings_renderer.js",
      "launch.js",
      "utils.js",
      "webauthn.js",
      "plugin-manager.js",
      "index.html",
      "settings.html",
      "styles.css",
      "icon.png",
      "plugins/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png",
      "category": "public.app-category.business"
    },
    "directories": {
      "output": "dist"
    }
  }
}
