{
  "name": "connectwise-manage-pp",
  "version": "0.2.1",
  "description": "ConnectWise Manage++ wrapper with automatic ticket note backup",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "lint": "eslint .",
    "test": "jest",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable",
    "build-mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "electron": "^41.5.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  },
  "build": {
    "appId": "com.connectwise.managepp",
    "productName": "ConnectWise Manage++",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png",
      "category": "public.app-category.business"
    },
    "directories": {
      "output": "dist"
    }
  }
}
